NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/littlejoy?replicaSet=rs0
# Configure a unique random value of at least 32 characters before starting the API.
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=littlejoy_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Flat COD delivery fee in the store's chosen currency. Set to 0 for free delivery.
DELIVERY_FEE=0
